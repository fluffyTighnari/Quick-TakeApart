# Source documentation (README.md, docs/) is intentionally tracked.
# Generated screenshots/captures and old design artifacts are not.

# Secrets and local user data
.env
.env.*
!.env.example
.qta/
**/.qta/

# Python
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.log

# Node / build output
node_modules/
web/node_modules/
web/dist/
dist/
build/
*.egg-info/

# Tauri desktop runtime/build artifacts
desktop/node_modules/
desktop/dist/
desktop/.tools/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/runtime/
desktop/build-release.log

# Generated images/screenshots; source icons are explicit exceptions
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
!desktop/src-tauri/icons/**
!desktop/icon-source.png

# Browser/test captures
.playwright/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
.stfolder/
.stignore
